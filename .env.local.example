# Firebase web app (Firebase Console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side profile bootstrap (recommended for first login)
# 1. Firebase Console → Project settings → Service accounts → Generate new private key
# 2. Save the downloaded JSON as firebase-service-account.json in the project root
# 3. Uncomment the line below and restart `npm run dev`
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Alternative: paste the entire JSON on one line (escape quotes if needed)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
